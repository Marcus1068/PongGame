    "First player to reach 5 points wins. Every 3 alternating rally hits triggers a speed boost!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer zuerst 5 Punkte erreicht, gewinnt. Jede 3. abwechselnde Ballrückgabe aktiviert einen Geschwindigkeitsschub!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primero en llegar a 5 puntos gana. ¡Cada 3 golpes alternos de rally activan un turbo de velocidad!"
